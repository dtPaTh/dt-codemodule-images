ARG DT_BASEIMG

FROM golang:1.21 AS build
WORKDIR /src
COPY bootstrap.go .
RUN go build -o /bin/bootstrap ./bootstrap.go

FROM ${DT_BASEIMG} AS dtbase
COPY --from=build /bin/bootstrap /bin/bootstrap
ENTRYPOINT ["/bin/bootstrap","healthprobe","/opt/dynatrace/oneagent/agent/lib64/dynatrace-bootstrapper", "--source=/opt/dynatrace/oneagent","--target=/home/dynatrace/oneagent","--debug"]
